/* The version resource of dinput8.dll: what Windows shows in the file's
 * Properties, filled in by the build.
 *
 * The version arrives as defines - /d SH_FILEVER=1,0,0,4 /d SH_VERSTR=1.0-beta4
 * - because scripthook.h is where the version lives: the loader's start up
 * line, the crash report header, the About page and the package folder name all
 * read that one string, and a copy written here could only disagree with it.
 * The build parses it: "1.0-beta4" is file version 1.0.0.4, the beta number in
 * the fourth field, and a plain "1.0.3" would be 1.0.3.0. StringFileInfo keeps
 * the letters, so the Properties dialog reads "1.0-beta4".
 *
 * CompanyName, LegalCopyright and Comments are deliberately absent: the reader
 * of a Properties dialog is looking for which build this is, and nothing here
 * has to say who made it - the About page and the README do that.
 *
 * build_msvc.ps1 compiles this with rc.exe, the Makefile with windres, both
 * passing the same three defines; keep the two in step.
 */
#include <winver.h>

#ifndef SH_FILEVER
#define SH_FILEVER 1,0,0,0
#endif
#ifndef SH_VERSTR
#define SH_VERSTR 1.0.0.0
#endif
#ifndef SH_FILEFLAGS
#define SH_FILEFLAGS 0
#endif

#define SH_STR_(x) #x
#define SH_STR(x) SH_STR_(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     SH_FILEVER
 PRODUCTVERSION  SH_FILEVER
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       SH_FILEFLAGS
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "GRW ScriptHook: the dinput8 proxy, the plugin loader and the menu"
            VALUE "FileVersion",      SH_STR(SH_VERSTR)
            VALUE "InternalName",     "dinput8"
            VALUE "OriginalFilename", "dinput8.dll"
            VALUE "ProductName",      "GRW ScriptHook"
            VALUE "ProductVersion",   SH_STR(SH_VERSTR)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
